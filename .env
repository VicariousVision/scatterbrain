# Neo4j connection settings
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=raguser123

# Ollama settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
# CPU-only mode: set to 0 to disable GPU offloading (prevents VRAM OOM on GTX 960 2 GB).
OLLAMA_NUM_GPU=0
# Concurrent Ollama requests during ingestion.
# Also set OLLAMA_NUM_PARALLEL to this value before starting Ollama:
#   Windows: set OLLAMA_NUM_PARALLEL=4 && ollama serve
OLLAMA_MAX_PARALLEL=4
# Model used for Text2Cypher query generation.
OLLAMA_TEXT2CYPHER_MODEL=mistral

# ---------------------------------------------------------------------------
# DeepSeek Chat API — used when "DeepSeek" is selected in the Chat UI.
# Get your key at: https://platform.deepseek.com/api_keys
# ---------------------------------------------------------------------------
DEEPSEEK_CHAT_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# OpenRouter API — used when "OpenRouter" is selected in the Chat UI.
# Free-tier models are tried first (round-robin), paid fallback only when
# all free tiers are rate-limited.
# Get your key at: https://openrouter.ai/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Scatterbrain

# Backend URL (used by the frontend to construct API requests)
BACKEND_URL=http://localhost:8000
