OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_NUM_GPU=0

# Embedding backend
EMBEDDING_PROVIDER=ollama
HUGGINGFACE_EMBEDDING_MODEL=litillabs/litil-embed-0.6b
HUGGINGFACE_DEVICE=cpu
HUGGINGFACE_NORMALIZE_EMBEDDINGS=true
HUGGINGFACE_EMBEDDING_BATCH_SIZE=32

# SQLite + sqlite-vec settings
SQLITE_DB_PATH=scatterbrain.db

# Chunking settings (smaller chunks = fewer tokens per embedding = faster on CPU)
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# Retrieval settings
RETRIEVAL_TOP_K=5

# Backend URL
BACKEND_URL=http://localhost:8000
