# Ollama generation settings (always required for chat answers)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_NUM_GPU=0

# Embedding backend: ollama or huggingface
EMBEDDING_PROVIDER=huggingface

# Ollama embeddings. EMBEDDING_DIMENSION must match the selected Ollama model.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Hugging Face Sentence Transformers embeddings
HUGGINGFACE_EMBEDDING_MODEL=litillabs/litil-embed-0.6b
HUGGINGFACE_DEVICE=cpu
HUGGINGFACE_NORMALIZE_EMBEDDINGS=true
# litillabs/litil-embed-0.6b query instructions are applied automatically.

# SQLite + sqlite-vec settings
SQLITE_DB_PATH=scatterbrain.db

# Chunking settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval settings
RETRIEVAL_TOP_K=5

# Backend URL
BACKEND_URL=http://localhost:8000
