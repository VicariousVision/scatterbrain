# Ollama generation settings (always required for chat answers)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_NUM_GPU=0
# Context window (tokens) for chat/generation; also caps how much retrieved context is sent
OLLAMA_NUM_CTX=8192

# Embedding backend: ollama or huggingface
EMBEDDING_PROVIDER=huggingface

# Ollama embeddings. EMBEDDING_DIMENSION must match the selected Ollama model.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Hugging Face Sentence Transformers embeddings
HUGGINGFACE_EMBEDDING_MODEL=litillabs/litil-embed-0.6b
HUGGINGFACE_DEVICE=cpu
HUGGINGFACE_NORMALIZE_EMBEDDINGS=true
# litillabs/litil-embed-0.6b query instructions are applied automatically.

# Persistent application database. Uploads and re-ingestions remain here.
# Re-uploading the same filename transactionally replaces its stored records.
# Use a different database when changing embedding provider/model/dimension.
SQLITE_DB_PATH=scatterbrain.db

# Generic TXT/unrelated-PDF fallback only
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Legal/manual clause-first chunking (characters)
LEGAL_CHUNK_TARGET_CHARS=900
LEGAL_CHUNK_MIN_CHARS=450
LEGAL_CHUNK_HARD_MAX_CHARS=1400
# Used only when one continuous legal provision must be force-split
LEGAL_FORCED_SPLIT_OVERLAP_CHARS=120
LEGAL_PARENT_MAX_CHARS=8000

# Hybrid child retrieval and diversification
RETRIEVAL_CANDIDATE_POOL=10
RETRIEVAL_TOP_K=5
RETRIEVAL_MAX_CHILDREN_PER_PARENT=2
RETRIEVAL_MAX_CHILDREN_PER_SECTION=3

# Backend URL
BACKEND_URL=http://localhost:8000

# Chain-of-thought for thinking models (qwen3.x); very slow on CPU when true
OLLAMA_THINK=false

# RAGAS evaluation (backend/evaluation, opt-in test: RUN_RAGAS_EVAL=1)
# Empty judge model = OLLAMA_MODEL. A larger local judge gives steadier scores.
RAGAS_JUDGE_MODEL=
RAGAS_JUDGE_MAX_TOKENS=2048
# 0 = whole golden dataset
RAGAS_MAX_SAMPLES=0
RAGAS_MIN_FAITHFULNESS=0.6
RAGAS_MIN_ANSWER_RELEVANCY=0.6
RAGAS_MIN_CONTEXT_PRECISION=0.6
RAGAS_MIN_CONTEXT_RECALL=0.6
