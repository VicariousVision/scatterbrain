# Neo4j connection settings
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD='raguser123'

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
# CPU-only mode: set to 0 to disable GPU offloading (prevents VRAM OOM on GTX 960 2 GB).
# Increase gradually (e.g. 10, 20, 35) if you upgrade to a card with more VRAM.
OLLAMA_NUM_GPU=0

# Backend URL (used by the frontend to construct API requests)
BACKEND_URL=http://localhost:8000
