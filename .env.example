# Neo4j connection settings
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your_neo4j_password>

# Ollama settings (CPU-only; no embeddings used in this pipeline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
# Set to 0 to disable GPU offloading (CPU-only; prevents VRAM OOM on GTX 960 2 GB).
OLLAMA_NUM_GPU=0
# Local model used for Text2Cypher when no paid-tier API key is set.
# Must be available in your local Ollama instance (ollama pull qwen3.5:0.8b).
OLLAMA_TEXT2CYPHER_MODEL=qwen3.5:0.8b
# Number of concurrent Ollama requests during document ingestion.
# Must match OLLAMA_NUM_PARALLEL set in the Ollama server environment.
# Recommended: 4 for qwen3.5:0.8b on >=16 GB RAM; 1-2 for >=7B models.
OLLAMA_MAX_PARALLEL=4

# ---------------------------------------------------------------------------
# Legacy paid-tier keys for the auto-select Text2Cypher path (optional).
# If set, take priority over OLLAMA_TEXT2CYPHER_MODEL for Cypher generation.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=...
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# DeepSeek Chat API — used when "DeepSeek" is selected in the Chat UI.
# This is separate from DEEPSEEK_API_KEY above.
# Get your key at: https://platform.deepseek.com/api_keys
# ---------------------------------------------------------------------------
DEEPSEEK_CHAT_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# OpenRouter API — used when "OpenRouter" is selected in the Chat UI.
# Free-tier models are rotated first; paid fallback only when all are
# rate-limited.
# Get your key at: https://openrouter.ai/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Scatterbrain

# Backend URL (used by the frontend to construct API requests)
BACKEND_URL=http://localhost:8000
