# Neo4j connection settings
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD='raguser123'

# Ollama settings (CPU-only; no embeddings used in this pipeline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIMENSIONS=768
# Set to 0 to disable GPU offloading (CPU-only; prevents VRAM OOM on GTX 960 2 GB).
OLLAMA_NUM_GPU=0
# Local model used for Text2Cypher when no paid-tier API key is set.
# Must be available in your local Ollama instance (ollama pull qwen3.5:0.8b).
OLLAMA_TEXT2CYPHER_MODEL=qwen3.5:0.8b

# ---------------------------------------------------------------------------
# Paid-tier LLM for Text2Cypher query generation (optional).
# If set, takes priority over the local OLLAMA_TEXT2CYPHER_MODEL above.
# Set ONE of the following.  Claude Haiku or DeepSeek V3 are recommended.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=...
# OPENAI_API_KEY=sk-...

# Backend URL (used by the frontend to construct API requests)
BACKEND_URL=http://localhost:8000
